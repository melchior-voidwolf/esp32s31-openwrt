Backport riscv32 ilp32f single-precision setjmp/longjmp support and
enable vDSO clock_gettime from musl 1.2.6.

--- a/src/setjmp/riscv32/setjmp.S
+++ b/src/setjmp/riscv32/setjmp.S
@@ -23,18 +23,24 @@ setjmp:
