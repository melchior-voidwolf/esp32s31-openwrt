# riscv32 plumbing for include/target.mk — applied on top of the OpenWrt
# tree before building the esp32s31 target.  Mirrors the riscv64 block; ABI
# is ilp32f single-precision hardware float + full S31 ISA extensions.
--- a/include/target.mk
+++ b/include/target.mk
@@ -270,6 +270,10 @@ ifeq ($(DUMP),1)
   ifeq ($(ARCH),riscv64)
     CPU_TYPE ?= generic
     CPU_CFLAGS_generic:=-mabi=lp64d -march=rv64gc
   endif
+  ifeq ($(ARCH),riscv32)
+    CPU_TYPE ?= generic
+    CPU_CFLAGS_generic:=-mabi=ilp32f -march=rv32imafc_zicsr_zifencei_zba_zbb_zbs
+  endif
   ifeq ($(ARCH),loongarch64)
