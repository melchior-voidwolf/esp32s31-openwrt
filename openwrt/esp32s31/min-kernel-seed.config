# Minimal bootable rv32 6.12 seed: serial + mmc + MTD + USB + r8152 + bridge
# + squashfs.  What a "flash firmware" kernel minimally needs on S31
# (S31 platform glue itself comes from patches; not in this generic build).
CONFIG_32BIT=y
# CONFIG_64BIT is not set
CONFIG_NONPORTABLE=y
CONFIG_ARCH_RV32I=y
# CONFIG_ARCH_RV64I is not set
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_DW=y
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_NET=y
CONFIG_BRIDGE=y
CONFIG_SQUASHFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PRINTK=y
CONFIG_BINFMT_ELF=y
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_EMBEDDED is not set
# S31 platform + wifi stack (esp_hosted full-MAC: no mac80211 needed)
CONFIG_SOC_ESP32S31=y
CONFIG_ESP32S31_CLIC=y
CONFIG_ESP32S31_CACHE=y
CONFIG_ESP32S31_HOSTED=y
CONFIG_CFG80211=y
CONFIG_BT=y
CONFIG_PHY_ESP32S31_USB=y
CONFIG_DWMAC_ESP32S31=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_RISCV_DMA_NONCOHERENT=y
CONFIG_RISCV_NONSTANDARD_CACHE_OPS=y

# built-in DTB (loader hands off without a DTB pointer)
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_SOURCE="espressif/esp32s31_korvo1"
CONFIG_KERNEL_GZIP=y
# flash-firmware trim: usb-nic only (no internal MAC), no netfilter (pure
# bridge AP), no i2c/leds.  MTD stays (rootfs lives on shm_flash).
# CONFIG_STMMAC_ETH is not set
# CONFIG_DWMAC_ESP32S31 is not set
# CONFIG_STMMAC_PLATFORM is not set
# CONFIG_NETFILTER is not set
# CONFIG_I2C is not set
# CONFIG_NEW_LEDS is not set
# CONFIG_LEDS_CLASS is not set
# flash firmware: root on the shm_flash MTD (squashfs, read-only)
CONFIG_CMDLINE_FORCE=y
CONFIG_CMDLINE="initcall_debug earlycon=sbi console=ttyS0,115200 loglevel=7 root=/dev/mtdblock0 rootfstype=squashfs ro esp32_shm.radio_service=wifi"
# S31 PSRAM lives at 0x50000000 (not the standard 0x80000000)
CONFIG_PHYS_RAM_BASE_FIXED=y
CONFIG_PHYS_RAM_BASE=0x50000000
# memory management and the run-time plumbing busybox/procd assume
CONFIG_MMU=y
CONFIG_RISCV_SBI=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_UNIX=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_INOTIFY_USER=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CGROUPS=y
# early boot diagnostics: sbi earlycon must speak before ttyS0 probes
CONFIG_SERIAL_EARLYCON=y
CONFIG_EARLY_PRINTK=y
CONFIG_SERIAL_EARLYCON_RISCV_SBI=y
CONFIG_DEBUG_DRIVER=y
