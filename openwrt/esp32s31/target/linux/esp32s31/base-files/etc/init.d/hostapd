#!/bin/sh /etc/rc.common
# SoftAP starter: hostapd on the esp_hosted wlan0, bridged into br-lan.
# Started after network; waits for wlan0 (the hart0 firmware chain brings
# the wifi device up 1-2 minutes after boot).  wpad is gone from rc.d:
# with no /etc/config/wireless it only ran a global hostapd with zero BSSs.
# OPEN AP: the firmware rejects add_node_ap (ret=262) when privacy/WPA is
# configured — WPA softAP needs firmware support this build lacks.
START=25
STOP=65

USE_PROCD=1

start_service() {
	local i
	for i in $(seq 1 90); do
		[ -e /sys/class/net/wlan0 ] && break
		sleep 2
	done
	[ -e /sys/class/net/wlan0 ] || {
		echo "hostapd: wlan0 never appeared, skipping" >&2
		return 0
	}
	procd_open_instance hostapd
	procd_set_param command /usr/sbin/hostapd /etc/hostapd.conf
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
